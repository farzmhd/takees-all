# ============================================================
#  Takees Marketing — Hostinger Shared Hosting Configuration
#  Place this file in public_html/ (project root)
# ============================================================

# ----------------------------------------------------------
#  Charset & MIME Types
# ----------------------------------------------------------
AddDefaultCharset UTF-8

AddType image/svg+xml .svg
AddType image/webp    .webp
AddType font/woff2    .woff2
AddType font/woff     .woff

# ----------------------------------------------------------
#  Compression (Gzip)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
#  Browser Caching
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache (content changes)
  ExpiresByType text/html                 "access plus 1 hour"

  # CSS & JS — medium cache
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # Images — long cache
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
#  Clean Trailing Slash for Location Subfolders
#  Ensures /kochi  →  /kochi/  and  /bangalore  →  /bangalore/
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect /kochi (no slash) → /kochi/
  RewriteCond %{REQUEST_URI} ^/kochi$
  RewriteRule ^ /kochi/ [R=301,L]

  # Redirect /bangalore (no slash) → /bangalore/
  RewriteCond %{REQUEST_URI} ^/bangalore$
  RewriteRule ^ /bangalore/ [R=301,L]

  # Serve index.html for bare subfolder requests (if not already served)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ $1/ [R=301,L]
</IfModule>

# ----------------------------------------------------------
#  Custom 404 Error Page
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
#  Security Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------
#  Prevent access to hidden/dot files
# ----------------------------------------------------------
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
